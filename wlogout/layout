{
    "label" : "lock",
    "action" : "sleep 0.2 && swaylock",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernar",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "if [ \"$XDG_CURRENT_DESKTOP\" = \"Hyprland\" ]; then command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit; else pkill mango; fi",
    "text" : "Cerrar Sesión",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Apagar",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspender",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reiniciar",
    "keybind" : "r"
}
