binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a Terminal: foot" { spawn "foot"; }
    Mod+D hotkey-overlay-title="Open Noctalia App Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B hotkey-overlay-title="Open Browser: Zen Browser" { spawn "zen-browser"; }
    Mod+E hotkey-overlay-title="Open File Browser: Nautilus" { spawn "nautilus"; }
    // Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; } I'll do screen lock later (maybe)

    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

    Mod+O hotkey-overlay-title="Toggle Overview" repeat=false { toggle-overview; }
    Mod+Q hotkey-overlay-title="Close Window" repeat=false { close-window; }

    Mod+Left  hotkey-overlay-title="Focus Column Left" { focus-column-left; }
    Mod+Down  hotkey-overlay-title="Focus Window Down" { focus-window-down; }
    Mod+Up    hotkey-overlay-title="Focus Window Up" { focus-window-up; }
    Mod+Right hotkey-overlay-title="Focus Column Right" { focus-column-right; }
    Mod+H     hotkey-overlay-title="Focus Column Left" { focus-column-left; }
    Mod+J     hotkey-overlay-title="Focus Window Down" { focus-window-down; }
    Mod+K     hotkey-overlay-title="Focus Window Up" { focus-window-up; }
    Mod+L     hotkey-overlay-title="Focus Column Right" { focus-column-right; }

    Mod+Shift+Left  hotkey-overlay-title="Move Column Left" { move-column-left; }
    Mod+Shift+Down  hotkey-overlay-title="Move Window Down" { move-window-down; }
    Mod+Shift+Up    hotkey-overlay-title="Move Window Up" { move-window-up; }
    Mod+Shift+Right hotkey-overlay-title="Move Column Right" { move-column-right; }
    Mod+Shift+H     hotkey-overlay-title="Move Column Left" { move-column-left; }
    Mod+Shift+J     hotkey-overlay-title="Move Window Down" { move-window-down; }
    Mod+Shift+K     hotkey-overlay-title="Move Window Up" { move-window-up; }
    Mod+Shift+L     hotkey-overlay-title="Move Column Right" { move-column-right; }

    Mod+Home hotkey-overlay-title="Focus First Column" { focus-column-first; }
    Mod+End  hotkey-overlay-title="Focus Last Column" { focus-column-last; }
    Mod+Shift+Home hotkey-overlay-title="Move Column to First" { move-column-to-first; }
    Mod+Shift+End  hotkey-overlay-title="Move Column to Last" { move-column-to-last; }

    Mod+Ctrl+Left  hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Ctrl+Down  hotkey-overlay-title="Focus Monitor Down" { focus-monitor-down; }
    Mod+Ctrl+Up    hotkey-overlay-title="Focus Monitor Up" { focus-monitor-up; }
    Mod+Ctrl+Right hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }
    Mod+Ctrl+H     hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Ctrl+J     hotkey-overlay-title="Focus Monitor Down" { focus-monitor-down; }
    Mod+Ctrl+K     hotkey-overlay-title="Focus Monitor Up" { focus-monitor-up; }
    Mod+Ctrl+L     hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }

    Ctrl+Alt+Left  hotkey-overlay-title="Move Column to Monitor Left" { move-column-to-monitor-left; }
    Ctrl+Alt+Down  hotkey-overlay-title="Move Column to Monitor Down" { move-column-to-monitor-down; }
    Ctrl+Alt+Up    hotkey-overlay-title="Move Column to Monitor Up" { move-column-to-monitor-up; }
    Ctrl+Alt+Right hotkey-overlay-title="Move Column to Monitor Right" { move-column-to-monitor-right; }
    Ctrl+Alt+H     hotkey-overlay-title="Move Column to Monitor Left" { move-column-to-monitor-left; }
    Ctrl+Alt+J     hotkey-overlay-title="Move Column to Monitor Down" { move-column-to-monitor-down; }
    Ctrl+Alt+K     hotkey-overlay-title="Move Column to Monitor Up" { move-column-to-monitor-up; }
    Ctrl+Alt+L     hotkey-overlay-title="Move Column to Monitor Right" { move-column-to-monitor-right; }

    Mod+Page_Down      hotkey-overlay-title="Focus Workspace Down" { focus-workspace-down; }
    Mod+Page_Up        hotkey-overlay-title="Focus Workspace Up" { focus-workspace-up; }
    Mod+U              hotkey-overlay-title="Focus Workspace Down" { focus-workspace-down; }
    Mod+I              hotkey-overlay-title="Focus Workspace Up" { focus-workspace-up; }
    Mod+Shift+Page_Down hotkey-overlay-title="Move Column to Workspace Down" { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   hotkey-overlay-title="Move Column to Workspace Up" { move-column-to-workspace-up; }
    Mod+Shift+U         hotkey-overlay-title="Move Column to Workspace Down" { move-column-to-workspace-down; }
    Mod+Shift+I         hotkey-overlay-title="Move Column to Workspace Up" { move-column-to-workspace-up; }

    Mod+Ctrl+Page_Down hotkey-overlay-title="Move Workspace Down" { move-workspace-down; }
    Mod+Ctrl+Page_Up   hotkey-overlay-title="Move Workspace Up" { move-workspace-up; }
    Mod+Ctrl+U         hotkey-overlay-title="Move Workspace Down" { move-workspace-down; }
    Mod+Ctrl+I         hotkey-overlay-title="Move Workspace Up" { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 hotkey-overlay-title="Focus Workspace Down" { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 hotkey-overlay-title="Focus Workspace Up" { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Move Column to Workspace Down" { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title="Move Column to Workspace Up" { move-column-to-workspace-up; }

    Mod+WheelScrollRight      hotkey-overlay-title="Focus Column Right" { focus-column-right; }
    Mod+WheelScrollLeft       hotkey-overlay-title="Focus Column Left" { focus-column-left; }
    Mod+Ctrl+WheelScrollRight hotkey-overlay-title="Move Column Right" { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  hotkey-overlay-title="Move Column Left" { move-column-left; }

    Mod+Shift+WheelScrollDown      hotkey-overlay-title="Focus Column Right" { focus-column-right; }
    Mod+Shift+WheelScrollUp        hotkey-overlay-title="Focus Column Left" { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown hotkey-overlay-title="Move Column Right" { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   hotkey-overlay-title="Move Column Left" { move-column-left; }

    Mod+1 hotkey-overlay-title="Focus Workspace 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="Focus Workspace 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="Focus Workspace 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="Focus Workspace 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="Focus Workspace 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="Focus Workspace 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="Focus Workspace 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="Focus Workspace 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="Focus Workspace 9" { focus-workspace 9; }
    Alt+1 hotkey-overlay-title="Move Column to Workspace 1" { move-column-to-workspace 1; }
    Alt+2 hotkey-overlay-title="Move Column to Workspace 2" { move-column-to-workspace 2; }
    Alt+3 hotkey-overlay-title="Move Column to Workspace 3" { move-column-to-workspace 3; }
    Alt+4 hotkey-overlay-title="Move Column to Workspace 4" { move-column-to-workspace 4; }
    Alt+5 hotkey-overlay-title="Move Column to Workspace 5" { move-column-to-workspace 5; }
    Alt+6 hotkey-overlay-title="Move Column to Workspace 6" { move-column-to-workspace 6; }
    Alt+7 hotkey-overlay-title="Move Column to Workspace 7" { move-column-to-workspace 7; }
    Alt+8 hotkey-overlay-title="Move Column to Workspace 8" { move-column-to-workspace 8; }
    Alt+9 hotkey-overlay-title="Move Column to Workspace 9" { move-column-to-workspace 9; }

    Mod+Tab hotkey-overlay-title="Focus Previous Workspace" { focus-workspace-previous; }

    Mod+BracketLeft  hotkey-overlay-title="Consume/Expel Window Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Consume/Expel Window Right" { consume-or-expel-window-right; }

    Mod+Comma  hotkey-overlay-title="Consume Window Into Column" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="Expel Window From Column" { expel-window-from-column; }

    Mod+R hotkey-overlay-title="Switch Preset Column Width" { switch-preset-column-width; }
    Mod+Shift+R hotkey-overlay-title="Switch Preset Column Width Back" { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R hotkey-overlay-title="Switch Preset Window Height" { switch-preset-window-height; }
    Mod+Ctrl+R hotkey-overlay-title="Reset Window Height" { reset-window-height; }

    Alt+A hotkey-overlay-title="Maximize Column" { maximize-column; }
    Alt+F hotkey-overlay-title="Fullscreen Window" { fullscreen-window; }

    Mod+M hotkey-overlay-title="Maximize Window to Edges" { maximize-window-to-edges; }
    Mod+Shift+F hotkey-overlay-title="Expand Column to Available Width" { expand-column-to-available-width; }

    Mod+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+Ctrl+C hotkey-overlay-title="Center Visible Columns" { center-visible-columns; }

    Mod+Minus hotkey-overlay-title="Decrease Column Width" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Increase Column Width" { set-column-width "+10%"; }
    Mod+Shift+Minus hotkey-overlay-title="Decrease Window Height" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Increase Window Height" { set-window-height "+10%"; }

    Alt+Backslash hotkey-overlay-title="Toggle Window Floating" { toggle-window-floating; }
    Mod+Alt+Backslash hotkey-overlay-title="Switch Focus Floating/Tiling" { switch-focus-between-floating-and-tiling; }

    Mod+W hotkey-overlay-title="Toggle Tabbed Display" { toggle-column-tabbed-display; }

    Print hotkey-overlay-title="Screenshot" { screenshot; }
    Ctrl+Print hotkey-overlay-title="Screenshot Screen" { screenshot-screen; }
    Alt+Print hotkey-overlay-title="Screenshot Window" { screenshot-window; }

    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Toggle Keyboard Shortcuts Inhibit" { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E hotkey-overlay-title="Quit Niri" { quit; }
    Ctrl+Alt+Delete hotkey-overlay-title="Quit Niri" { quit; }

    Mod+Shift+P hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }

    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Shift+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher"; }
    Mod+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
}